[Unit]
Description=Ollama CUDA Service
Wants=network-online.target
After=network.target network-online.target

[Service]
ExecStart=/usr/bin/ollama serve
# Warm gemma4:12b into VRAM as soon as the server is listening, and pin it there.
# Backgrounded on purpose: run synchronously this blocked "started" for ~7.3s,
# and since this unit is WantedBy=multi-user.target that delayed graphical.target
# by the same amount. The child stays in this unit's cgroup, so the warm still
# runs to completion (~7s after boot) and still dies with the service.
ExecStartPost=-/usr/bin/bash -c '/usr/local/bin/ollama-cuda-warm &'
WorkingDirectory=/var/lib/ollama
Environment="HOME=/var/lib/ollama"
Environment="OLLAMA_MODELS=/var/lib/ollama"
Environment="CUDA_VISIBLE_DEVICES=0"
Environment="HIP_VISIBLE_DEVICES=-1"
Environment="ROCR_VISIBLE_DEVICES=-1"
Environment="OLLAMA_NUM_PARALLEL=1"
Environment="OLLAMA_MAX_LOADED_MODELS=1"
Environment="OLLAMA_KEEP_ALIVE=-1"
Environment="OLLAMA_HOST=0.0.0.0:11435"
User=ollama
Group=ollama
Restart=on-failure
RestartSec=3
# The warm no longer blocks startup, but keep a generous timeout for the server.
TimeoutStartSec=300
RestartPreventExitStatus=1
Type=simple
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
